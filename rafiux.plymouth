[Plymouth Theme]
Name=Rafiux rx theme
Description=rx theme with logo and progressbar
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell 20
ImageDir=/usr/share/plymouth/themes/rafiux
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.5
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.5
HorizontalAlignment=.5
VerticalAlignment=.4
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.9
Transition=fade
TransitionDuration=0.5
BackgroundStartColor=0xFBFBFB
BackgroundEndColor=0x595959
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.6
ProgressBarWidth=350
ProgressBarHeight=5
ProgressBarBackgroundColor=0x515151
ProgressBarForegroundColor=0xFBFBFB
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=true
UseFirmwareBackground=false
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Optimize. Accelerate. Dominate.

[shutdown]
UseEndAnimation=true
UseFirmwareBackground=false
ProgressBarShowPercentComplete=false
UseProgressBar=false
Title=Shutting down

[reboot]
UseEndAnimation=true
UseFirmwareBackground=false
ProgressBarShowPercentComplete=false
UseProgressBar=false
Title=Restarting

[updates]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates

[system-upgrade]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing upgrades

[firmware-upgrade]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing firmware
